{
  "manifest_version": 3,
  "name": "Clawd Wallet",
  "version": "0.3.0",
  "description": "Solana-native Clawd / SolGPT wallet + computer-use agent surface: window.solana provider, agent auto-approve mode, voice trading, x402 auto-pay. Superintelligent Design · x402.life · solgpt.trade",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Clawd Wallet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "host_permissions": ["http://localhost:8787/*", "https://*/*", "http://*/*"],
  "permissions": ["storage", "activeTab", "tabs"]
}
