{
  "name": "@helmsman/extension",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "pack": "node ./scripts/pack.mjs --build",
    "typecheck": "tsc --noEmit",
    "test:keyring": "tsx src/wallet/keyring.vectors.ts",
    "test:clawd": "tsx src/clawd/clawd.vectors.ts",
    "store": "node ./scripts/pack.mjs --build",
    "test:security": "npm run build && node --test tests/security.test.mjs tests/wallet-standard.test.mjs",
    "test": "npm run test:security && npm run test:keyring && npm run test:clawd",
    "test:browser": "npm run build && node tests/browser-consent.mjs",
    "box:launch": "node ./scripts/launch-chromium.mjs",
    "box:verify": "npm run build && node ./scripts/launch-chromium.mjs --verify"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@solana/web3.js": "^3.1.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/wallet": "^1.1.1",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.11",
    "@wallet-standard/app": "^1.1.1",
    "playwright": "1.64.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "description": "Clawd / SolGPT Chrome extension \u2014 Solana wallet + agent surface. Superintelligent Design \u00b7 x402.life \u00b7 solgpt.trade",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
